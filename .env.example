# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#
# Read by the backend at startup (loaded into ./gradlew bootRun by backend/build.gradle).
# A value already exported in your shell wins over the one here.

# Which model answers: ollama | dummy
#   ollama  the local model, nothing leaves the machine — what this is aimed at
#   dummy   assembles answers from the file itself — no model, no network, always works,
#           and the default only so that a fresh clone runs before anything is installed
#
# gemini still exists in the source and is no longer a target. The seam is kept because two
# providers are what make a comparison mean anything; the hosted one is not coming back.
AI_PROVIDER=dummy

# --- Gemini -------------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
#
# The free tier's terms allow Google to use the input to improve its products; the paid
# tier's do not. Fixture files only on a free-tier key — real production decision logic needs
# a paid key and a look at the terms your team is already under.
GEMINI_API_KEY=

# gemini-3.5-flash-lite   the default; own quota bucket, right size for picking from an enum
# gemini-3.5-flash        stronger, but only 20 requests/day on the free tier against 500
#
# Models get retired, and a key issued after the retirement gets a 404 rather than a
# deprecation warning — gemini-2.5-flash was the first default here and is already gone for
# new keys. To see what your key can actually reach:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Free-tier requests per day for the model above. /api/health counts what this app spends
# and reports "remaining" against it. 0 means unknown — the count is still reported, just
# without a ceiling. From https://ai.dev/rate-limit, which is where to check yours:
#   flash-lite models   500/day, 15/min
#   full Flash models    20/day,  5/min
# Quota is per project per model, so switching models gives a separate bucket.
GEMINI_DAILY_LIMIT=500

# --- Ollama -------------------------------------------------------------------
# Everything below is optional. The defaults in application.yml are the measured ones and are
# what runs if this file says nothing; each line here is a knob you can turn, with what it costs.

# Which model answers. The target is laptops and servers short on CPU compute and not short on
# memory. On a CPU both halves of a turn are charged for ACTIVE parameters, not total:
# generation is bandwidth / active bytes, and prefill is FLOPS / (2 x active params). So a
# mixture-of-experts model that stores a lot and activates a little is not a compromise here,
# it is the only shape that gets both — and the ordering comes out backwards from the intuitive
# one, with the 24 GB model faster than the 6.6 GB one.
#
#   qwen3.5:35b   24 GB   ~3B active    server with RAM and no GPU; most capability per FLOP
#   gpt-oss:20b   13 GB   3.6B active   the laptop pick, and the only one benchmarked (17/20)
#   qwen3.5:9b     6.6 GB  9B active    the "7B-class" pick, and the slowest of these on CPU
#   qwen3.5:4b     3.4 GB  4B active    weak CPU, and the floor test for the harness
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434

# Private reasoning: tokens paid for and never read. Leave it off.
# Measured here on ornith:9b, the same request producing the same tool call:
#   think=false   15 generated tokens, 0.85s
#   think=true    52 generated tokens, 3.25s, plus 155 characters of reasoning nothing reads
# The tool schema is the thinking. A model with no thinking to disable answers 400 to this,
# which the provider notices and drops, so it is safe to leave set on any model.
OLLAMA_THINK=false

# How much conversation the model can hold. 8192 rather than 4096 because a failing write
# returns the re-rendered table, so conversations are short in turns and fat per turn.
# Truncation is silent and lands on the oldest thing in the window, which is the request.
OLLAMA_NUM_CTX=8192

# Zero. Choosing which tool to call is a classification, and sampling variance on a
# classification is pure downside — measured, at 0.1 the same request took two different paths.
OLLAMA_TEMPERATURE=0

# How long the model stays resident. -1 never unloads, which is what a server wants: reloading
# 13-24 GB is a cold start nobody is waiting through and it happens silently.
OLLAMA_KEEP_ALIVE=30m

# Caps on generation. Ollama's own default is unbounded, which is how "explain this file"
# became a crash: the reply never stopped, the client timed out, and the user was told the
# model could not be reached. Prose gets the tighter cap because a schema already bounds a
# structured reply and a question bounds nothing.
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_PREDICT_PROSE=200

# How long to wait for one call. 600 rather than 120 because on a CPU, loading the model cold
# and then prefilling a couple of thousand tokens can pass two minutes before anything has
# gone wrong.
OLLAMA_TIMEOUT_SECONDS=600

# --- CPU tuning ---------------------------------------------------------------
# Leave these commented out unless you are measuring. Ollama picks them from the machine and is
# usually right; they exist for the machine where it is not. Every one is a measurement to take
# rather than a value to guess — docs/12-small-model-adaptation.md has the reasoning.
#
# Prefill batch size, default 512. Prefill on a CPU is compute bound, and a larger batch raises
# arithmetic intensity, which is exactly what that wants. Costs memory, which you have.
#OLLAMA_NUM_BATCH=1024
#
# Threads, defaulting to physical cores. On a many-core server prefill scales with threads until
# memory bandwidth saturates; on a laptop, going past physical cores makes it worse.
#OLLAMA_NUM_THREAD=8
#
# Layers to offload to a GPU. 0 pins the model to the CPU, which on a box with a weak iGPU can
# beat partial offload and is easier to reason about.
#OLLAMA_NUM_GPU=0

# --- Ollama server settings ---------------------------------------------------
# These belong to the ollama process, not to this application, so export them where it starts.
#
#   OLLAMA_NUM_PARALLEL=1        parallel slots divide num_ctx and split the KV cache; a
#                                single-user desk tool wants the whole window and one prefix
#   OLLAMA_FLASH_ATTENTION=1     less KV traffic per generated token
#   OLLAMA_KV_CACHE_TYPE=q8_0    halves the KV cache, which is part of that same traffic
#   OLLAMA_KEEP_ALIVE=-1         the server-wide version of the setting above
#   OLLAMA_MODELS=/path          where the weights live

# --- Worked examples ----------------------------------------------------------
# One table from the DMN conformance suite, shown when a decision's coverage check has failed
# twice — a model whose corrections have stopped converging. Needs scripts/fetch-corpora.sh to
# have been run; without it there are no examples and nothing changes.
EXAMPLES_ENABLED=true
#EXAMPLES_DIR=../corpora/dmn-tck

# --- The tool loop ------------------------------------------------------------
# TOOL_LOOP=false forces the one-shot path everywhere, which is the floor every provider meets.
# The cap is twelve because eight was measured to be exactly enough and therefore too few.
#TOOL_LOOP=true
#TOOL_LOOP_MAX_TURNS=12
