# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#
# Read by the backend at startup (loaded into ./gradlew bootRun by backend/build.gradle).
# A value already exported in your shell wins over the one here.

# Which model answers: ollama | dummy
#   ollama  the local model, nothing leaves the machine — what this is aimed at
#   dummy   assembles answers from the file itself — no model, no network, always works,
#           and the default only so that a fresh clone runs before anything is installed
#
# gemini still exists in the source and is no longer a target. The seam is kept because two
# providers are what make a comparison mean anything; the hosted one is not coming back.
AI_PROVIDER=dummy

# --- Gemini -------------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
#
# The free tier's terms allow Google to use the input to improve its products; the paid
# tier's do not. Fixture files only on a free-tier key — real production decision logic needs
# a paid key and a look at the terms your team is already under.
GEMINI_API_KEY=

# gemini-3.5-flash-lite   the default; own quota bucket, right size for picking from an enum
# gemini-3.5-flash        stronger, but only 20 requests/day on the free tier against 500
#
# Models get retired, and a key issued after the retirement gets a 404 rather than a
# deprecation warning — gemini-2.5-flash was the first default here and is already gone for
# new keys. To see what your key can actually reach:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Free-tier requests per day for the model above. /api/health counts what this app spends
# and reports "remaining" against it. 0 means unknown — the count is still reported, just
# without a ceiling. From https://ai.dev/rate-limit, which is where to check yours:
#   flash-lite models   500/day, 15/min
#   full Flash models    20/day,  5/min
# Quota is per project per model, so switching models gives a separate bucket.
GEMINI_DAILY_LIMIT=500

# --- Ollama -------------------------------------------------------------------
# The target is laptops and servers short on CPU compute and not short on memory. On a CPU
# both halves of a turn are charged for ACTIVE parameters, not total: generation is
# bandwidth / active bytes, and prefill is FLOPS / (2 x active params). So a mixture-of-experts
# model that stores a lot and activates a little is not a compromise here, it is the only shape
# that gets both — and the ordering comes out backwards from the intuitive one.
#
#   qwen3.5:35b   24 GB   ~3B active    server with RAM and no GPU; most capability per FLOP
#   gpt-oss:20b   13 GB   3.6B active   the laptop pick, and the only one benchmarked (17/20)
#   qwen3.5:9b     6.6 GB  9B active    the "7B-class" pick, and the slowest of these on CPU
#   qwen3.5:4b     3.4 GB  4B active    weak CPU, and the floor test for the harness
#
# Run each with thinking off. Measured here: 9s against 25s, same answers.
# See docs/12-small-model-adaptation.md for the whole argument and the CPU settings table.
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434

# Raised from 120 for CPU machines: loading 13 GB cold and then prefilling a couple of
# thousand tokens at 15-25 tok/s can pass two minutes before anything has gone wrong, and
# what the user is shown for it is "I couldn't reach the local model".
OLLAMA_TIMEOUT_SECONDS=600
